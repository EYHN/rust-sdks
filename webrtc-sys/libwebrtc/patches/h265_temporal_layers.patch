+// Number of temporal layers to encode (1 = off). VideoToolbox exposes
+// exactly one enhancement layer via
+// kVTCompressionPropertyKey_BaseLayerFrameRateFraction, so 2 (L1T2) is the
+// maximum. Controlled by the SIMKIT_H265_TEMPORAL_LAYERS environment
+// variable so embedders can enable layering without new plumbing through
+// the codec-settings conversions.
+int H265TemporalLayerCountFromEnv() {
+  const char* value = std::getenv("SIMKIT_H265_TEMPORAL_LAYERS");
+  if (value == nullptr || value[0] == '\0') {
+    return 1;
+  }
+  int layers = atoi(value);
+  if (layers <= 1) {
+    return 1;
+  }
+  if (layers > 2) {
+    RTC_LOG(LS_WARNING) << "SIMKIT_H265_TEMPORAL_LAYERS=" << layers
+                        << " requested but VideoToolbox supports at most 2 "
+                           "temporal sublayers; using 2 (L1T2).";
+  }
+  return 2;
+}
+
+// Returns the temporal id (0-based) of the first VCL NALU in an AnnexB
+// buffer. The HEVC NAL header is two bytes:
+// [forbidden(1) | nal_unit_type(6) | nuh_layer_id(6) | nuh_temporal_id_plus1(3)].
+// VCL NALU types are 0-31. VideoToolbox marks temporal sublayers itself
+// when BaseLayerFrameRateFraction is set.
+uint8_t H265TemporalIdFromAnnexB(const uint8_t* data, size_t size) {
+  for (size_t i = 0; i + 4 < size; ++i) {
+    if (data[i] != 0 || data[i + 1] != 0) {
+      continue;
+    }
+    size_t header = 0;
+    if (data[i + 2] == 1) {
+      header = i + 3;
+    } else if (data[i + 2] == 0 && i + 5 < size && data[i + 3] == 1) {
+      header = i + 4;
+    } else {
+      continue;
+    }
+    const uint8_t nal_type = (data[header] >> 1) & 0x3F;
+    if (nal_type <= 31) {  // VCL NALU.
+      const uint8_t tid_plus1 = data[header + 1] & 0x07;
+      return tid_plus1 > 0 ? tid_plus1 - 1 : 0;
+    }
+  }
+  return 0;
+}
